# Files/directories to exclude from the WordPress.org SVN deployment
/.github
/.vscode
/.wordpress-org
/.git
/node_modules

/.gitignore
/.gitattributes
/.distignore
/AGENTS.md
/package.json
/package-lock.json
/pnpm-lock.yaml
/pnpm-workspace.yaml
/composer.json
/composer.lock
/pint.json
/README.md

/.agents
/skills-lock.json
/tests
/phpunit.xml.dist
/.phpunit.result.cache
/docs
/.editorconfig
/.nvmrc

# Compiled translations are provided by translate.wordpress.org; keep only the .pot template
/languages/*.po
/languages/*.mo
/languages/*.json

# Dev-only dependency (test fixtures); never ship
/vendor/wp-phpunit