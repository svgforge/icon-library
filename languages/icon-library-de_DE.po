#. Plugin Name of the plugin
#: icon-library.php
#: src/admin/admin.php:49
#: src/admin/admin.php:50
#: src/admin/admin.php:265
msgid "Icon Library"
msgstr "Icon Library"

#. Description of the plugin
#: icon-library.php
msgid "Gutenberg block that inserts SVG icons from a sprite file (ico.svg) via <use> and links them."
msgstr "Gutenberg-Block, der SVG-Icons aus einer Sprite-Datei (ico.svg) per <use> einfügt und verlinkt."

#. Author of the plugin
#: icon-library.php
msgid "svgforge"
msgstr "svgforge"

#: src/admin/admin.php:119
#: src/admin/admin.php:212
msgid "Sorry, you are not allowed to perform this action."
msgstr "Du hast keine Berechtigung für diese Aktion."

#: src/admin/admin.php:245
msgid "Upload (Settings)"
msgstr "Upload (Einstellungen)"

#: src/admin/admin.php:243
msgid "Filter icon_library_sprite_url"
msgstr "Filter icon_library_sprite_url"

#: src/admin/admin.php:247
msgid "Default (sprite.svg bundled with the plugin)"
msgstr "Standard (sprite.svg im Plugin)"

#: src/admin/admin.php:251
msgid "The SVG sprite file was uploaded and is now being used."
msgstr "Die SVG-Sprite-Datei wurde hochgeladen und wird jetzt verwendet."

#: src/admin/admin.php:252
msgid "The uploaded SVG sprite file was removed."
msgstr "Die hochgeladene SVG-Sprite-Datei wurde entfernt."

#: src/admin/admin.php:253
msgid "Only .svg or .svgz files can be uploaded."
msgstr "Nur .svg- oder .svgz-Dateien können hochgeladen werden."

#: src/admin/admin.php:254
msgid "The file could not be read."
msgstr "Die Datei konnte nicht gelesen werden."

#: src/admin/admin.php:255
msgid "The file is not a valid SVG file."
msgstr "Die Datei ist keine gültige SVG-Datei."

#: src/admin/admin.php:256
msgid "The file could not be written."
msgstr "Die Datei konnte nicht geschrieben werden."

#: src/admin/admin.php:278
msgid "SVG fragment library"
msgstr "SVG-Fragment-Bibliothek"

#: src/admin/admin.php:280
msgid "Upload an SVG sprite file that serves as the central icon library for the SVG Fragment block."
msgstr "Lade eine SVG-Sprite-Datei hoch, die als zentrale Symbol-Bibliothek für den Block „SVG Fragment“ dient."

#: src/admin/admin.php:281
msgid "Each icon is a <symbol id=\"my-icon\" viewBox=\"0 0 24 24\">…</symbol> element."
msgstr "Jedes Icon ist ein <symbol id=\"mein-icon\" viewBox=\"0 0 24 24\">…</symbol>-Element."

#: src/admin/admin.php:287
msgid "Active sprite file"
msgstr "Aktive Sprite-Datei"

#. translators: %s: Source of the sprite URL (filter, upload, default).
#: src/admin/admin.php:294
#, php-format
msgid "Source: %s"
msgstr "Quelle: %s"

#: src/admin/admin.php:303
msgid "Uploaded file"
msgstr "Hochgeladene Datei"

#. translators: %1$d: Number of symbol elements, %2$s: Date of the upload.
#: src/admin/admin.php:311
#, php-format
msgid "(%1$d symbols, uploaded on %2$s)"
msgstr "(%1$d Symbole, hochgeladen am %2$s)"

#: src/admin/admin.php:322
msgid "Remove uploaded file"
msgstr "Hochgeladene Datei entfernen"

#: src/admin/admin.php:331
msgid "Upload new file"
msgstr "Neue Datei hochladen"

#: src/admin/admin.php:333
msgid "An existing uploaded file is replaced by a new upload."
msgstr "Eine bestehende hochgeladene Datei wird beim Upload ersetzt."

#: src/admin/admin.php:342
msgid "SVG file (ico.svg)"
msgstr "SVG-Datei (ico.svg)"

#: src/admin/admin.php:354
msgid "Upload SVG sprite"
msgstr "SVG-Sprite hochladen"

#: build/block/render.php:21
#: src/block/render.php:21
#: build/block/index.js:1
msgid "Select symbol …"
msgstr "Symbol wählen …"

#: build/block/block.json
#: src/block/block.json
msgctxt "block title"
msgid "SVG Fragment"
msgstr "SVG Fragment"

#: build/block/block.json
#: src/block/block.json
msgctxt "block description"
msgid "Inserts a <symbol> from the sprite file and can be linked."
msgstr "Fügt ein <symbol> aus der Sprite-Datei ein und kann verlinkt werden."

#: build/block/block.json
#: src/block/block.json
msgctxt "block keyword"
msgid "svg"
msgstr "svg"

#: build/block/block.json
#: src/block/block.json
msgctxt "block keyword"
msgid "icon"
msgstr "icon"

#: build/block/block.json
#: src/block/block.json
msgctxt "block keyword"
msgid "sprite"
msgstr "sprite"

#: src/admin/admin.php:257
msgid "Uploading is disabled because the sprite file is overridden by the icon_library_sprite_url filter."
msgstr "Das Hochladen ist deaktiviert, weil die Sprite-Datei durch den Filter icon_library_sprite_url überschrieben wird."

#: src/admin/admin.php:274
msgid "The sprite file is currently overridden by the icon_library_sprite_url filter. Uploading a sprite file is disabled while the filter is active."
msgstr "Die Sprite-Datei wird derzeit durch den Filter icon_library_sprite_url überschrieben. Solange der Filter aktiv ist, ist das Hochladen einer Sprite-Datei deaktiviert."

#: src/admin/admin.php:346
msgid "Only .svg and .svgz files are accepted. svgforge-cli handles full sanitization and svgo optimization; as a safety net, the plugin strips scripts, event handlers and javascript: links on upload."
msgstr "Nur .svg- und .svgz-Dateien werden akzeptiert. svgforge-cli übernimmt die vollständige Sanitisierung und svgo-Optimierung; als Sicherheitsnetz werden Skripte, Event-Handler und javascript:-Links beim Upload entfernt."

#: src/admin/admin.php:359
msgid "Generate a sprite with svgforge-cli"
msgstr "Sprite mit svgforge-cli erzeugen"

#: src/admin/admin.php:361
msgid "Install svgforge-cli and create a symbol sprite from a folder of icons, then upload the generated SVG file."
msgstr "Installiere svgforge-cli und erzeuge aus einem Icon-Ordner eine Symbol-Sprite. Lade danach die erzeugte SVG-Datei hoch."

#: src/admin/admin.php:366
msgid "SVG files in subdirectories get IDs like directory--filename — each directory is then available as a filter in the icon picker."
msgstr "SVG-Dateien in Unterverzeichnissen erhalten IDs wie verzeichnis--dateiname — jedes Verzeichnis ist dann als Filter im Icon-Picker auswählbar."

#: build/block/index.js:1
